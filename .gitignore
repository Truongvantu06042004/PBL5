# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex
*.pyc

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# emacs
.dir-locals.el

# emacs temp file suffixes
*~
.#*
\#*#

# eclipse setting
.settings

# MacOS directory files
.DS_Store

# Application project files
**/sdkconfig
**/sdkconfig.old
**/build*

# Local build output and IDE caches. These are regenerated by ESP-IDF,
# Android Gradle, or Flutter and should not be stored in the repository.
**/build_*/
**/managed_components/
**/.gradle/
**/.dart_tool/
**/.idea/
**/local.properties
**/.flutter-plugins-dependencies
.vscode/

# Archive copies are redundant with the source tree and make GitHub clones large.
*.rar

# Never publish signing keys or private TLS keys.
*.jks
*.keystore
*.p12
*.key
*key.pem

# Doc build artifacts
docs/*/*/_build/
docs/*/*/sphinx-warning-log.txt
docs/*/*/sphinx-warning-log-sanitized.txt
